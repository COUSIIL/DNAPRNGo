# Production Nginx configuration (template).
# ${DOMAIN}, ${APP_DOMAIN}, ${CENTER_DOMAIN} and ${API_DOMAIN} are substituted
# from the environment at container start (see docker-compose.prod.yml).

server_tokens off;
client_max_body_size 10m;
gzip on;
gzip_comp_level 5;
gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

# ------------------------------------------------------------------ Astro (landing)
server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};
    include /etc/nginx/snippets/http-redirect.conf;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;

    location / {
        proxy_pass http://astro-app:4321;
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}

# ------------------------------------------------------------------ Nuxt App
server {
    listen 80;
    server_name ${APP_DOMAIN};
    include /etc/nginx/snippets/http-redirect.conf;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;

    location / {
        proxy_pass http://nuxt-app:3000;
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/proxy-websocket.conf;
    }
}

# ------------------------------------------------------------------ Nuxt Center (admin)
server {
    listen 80;
    server_name ${CENTER_DOMAIN};
    include /etc/nginx/snippets/http-redirect.conf;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${CENTER_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${CENTER_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CENTER_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;

    # Back-office: never indexed
    add_header X-Robots-Tag "noindex, nofollow" always;

    location / {
        proxy_pass http://nuxt-center:3000;
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/proxy-websocket.conf;
    }
}

# ------------------------------------------------------------------ Go API
server {
    listen 80;
    server_name ${API_DOMAIN};
    include /etc/nginx/snippets/http-redirect.conf;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;

    location / {
        proxy_pass http://go-backend:8080;
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}

