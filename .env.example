# Environment variables example

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=monorepo_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Go Backend
API_PORT=8080

# Production domains (for Nginx & Certbot)
DOMAIN=exemple.com
APP_DOMAIN=app.exemple.com
API_DOMAIN=api.exemple.com
CERTBOT_EMAIL=admin@exemple.com
