# Environment variables example

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=monorepo_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Mail
SMTP_HOST=management.exemple.com
SMTP_PORT=465
SMTP_USER=no_reply@management.exemple.com
SMTP_PASS=admin
SMTP_FROM_NAME=Exemple
SMTP_FROM_ADDRESS=no_reply@management.exemple.com

# pgAdmin (dev)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me

# Go Backend
CORS_ALLOW_ORIGINS=http://app.localhost,http://center.localhost,http://localhost
API_PORT=8080

# Production domains (for Nginx & Certbot)
DOMAIN=exemple.com
APP_DOMAIN=app.exemple.com
CENTER_DOMAIN=center.exemple.com
API_DOMAIN=api.exemple.com
CERTBOT_EMAIL=admin@exemple.com

ADMIN_EMAIL=test@gmail.com

ADMIN_PASSWORD=test

# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_with_a_long_random_secret_min_32_chars

# Overridden by docker-compose (development) and docker-compose.prod.yml (production)
APP_ENV=development

CHARGILY_SECRET_KEY=change_me
CHARGILY_PUBLIC_KEY=change_me
CHARGILY_MODE=test

R2_ACCOUNT_ID=change_me
R2_ACCESS_KEY_ID=change_me
R2_SECRET_ACCESS_KEY=change_me
R2_BUCKET_NAME=test-assets
